# Sanity
# Get these from https://www.sanity.io/manage
PUBLIC_SANITY_PROJECT_ID=
# Use `staging` locally — it's a disposable copy of production, safe to
# break. Refresh it with `npm run sanity:refresh-staging`. Never point
# local dev at `production`. See "Datasets" in the README.
PUBLIC_SANITY_DATASET=staging
# Generate at sanity.io/manage → API → Tokens → "Viewer" role
SANITY_API_READ_TOKEN=

# Visual Editing (set to false in production)
PUBLIC_SANITY_VISUAL_EDITING_ENABLED=true

# Site URL
PUBLIC_SITE_URL=http://localhost:4321

# Google Calendar
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_API_KEY=

# Google Sheets
GOOGLE_SHEETS_API_KEY=

# Mapbox Geocoding
MAPBOX_GEOCODER_TOKEN=
