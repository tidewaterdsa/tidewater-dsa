---
import RichText from "@/components/rich-text/RichText.astro"
import Layout from "@/layouts/main.astro"
import { loadQuery } from "@/lib/load-query"
import { PAGE_BY_SLUG_QUERY } from "@/sanity/queries"
import type { PAGE_BY_SLUG_QUERY_RESULT } from "@/sanity/types"

const { slug } = Astro.params
if (!slug) return new Response(null, { status: 404 })

const { data } = await loadQuery<PAGE_BY_SLUG_QUERY_RESULT>({
  query: PAGE_BY_SLUG_QUERY,
  params: { slug },
})

if (!data.page) return new Response(null, { status: 404 })

const { page } = data
---

<Layout title={page.title ?? undefined}>
  <main class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <header class="mb-8">
      <div class="mb-1 h-1 w-16 bg-primary"></div>
      <h1 class="text-3xl font-extrabold tracking-tight text-primary uppercase">
        {page.title}
      </h1>
    </header>

    <div class="mx-auto w-full max-w-readable">
      <RichText value={page.body ?? []} />
    </div>
  </main>
</Layout>
