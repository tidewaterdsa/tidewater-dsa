---
import { addMonths } from "date-fns"
import { CalendarIcon } from "lucide-react"
import Layout from "@/layouts/main.astro"
import SectionHeading from "@/components/headings/SectionHeading.astro"
import { UpcomingEvents } from "@/components/events/UpcomingEvents"
import { loadQuery } from "@/lib/load-query"
import { HOME_PAGE_QUERY, EVENT_TYPES_QUERY } from "@/sanity/queries"
import type {
  HOME_PAGE_QUERY_RESULT,
  EVENT_TYPES_QUERY_RESULT,
} from "@/sanity/types"
import { getEvents } from "@/lib/events"
import { urlFor } from "@/lib/sanity-image"
import { splitHighlight } from "@/lib/format-headline"
import { Card, CardContent } from "@tidewater-dsa/ui/components/card"
import { cn } from "@tidewater-dsa/ui/lib/utils"
import RichText from "@/components/rich-text/RichText.astro"
import { stegaClean } from "@sanity/client/stega"

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=300, stale-while-revalidate=600"
)

const [{ data: home }, { data: eventTypesData }] = await Promise.all([
  loadQuery<HOME_PAGE_QUERY_RESULT>({ query: HOME_PAGE_QUERY }),
  loadQuery<EVENT_TYPES_QUERY_RESULT>({ query: EVENT_TYPES_QUERY }),
])

const eventTypes = eventTypesData ?? []

// Fetch upcoming events from Google Calendar.
// 90-day window covers any active chapter's upcoming meetings.
const now = new Date()
const rangeEnd = addMonths(now, 3)

let events: Awaited<ReturnType<typeof getEvents>> = []
try {
  const all = await getEvents(
    { rangeStart: now, rangeEnd },
    Astro.locals.runtime?.env
  )
  events = all
    .filter((e) => new Date(e.endISO) >= now)
    .sort((a, b) => a.startISO.localeCompare(b.startISO))
    .slice(0, 3)
} catch (err) {
  console.error("[index.astro] Failed to fetch events:", err)
}

const ctaPosition = stegaClean(home?.heroCtaPosition) || "bottom-left"

const ctaPositionClasses = {
  center: "items-center text-center",
  "bottom-left": "items-start text-left",
  "bottom-right": "items-end text-right",
}

const bodyImageUrl = home?.bodyImage?.asset
  ? urlFor(home.bodyImage).width(800).quality(80).url()
  : null

const eventsImageUrl = home?.eventsImage?.asset
  ? urlFor(home.eventsImage).width(800).quality(80).url()
  : null

const heroImageUrl = home?.heroImage
  ? urlFor(home.heroImage).width(1920).quality(80).url()
  : null

const heroParts = home?.heroHeadline ? splitHighlight(home.heroHeadline) : null

// Count standard text blocks in Sanity Portable Text
const paragraphCount = Array.isArray(home?.body)
  ? home.body.filter((block) => block._type === "block").length
  : 0

const aspectDenominator = Math.min(Math.max(paragraphCount + 1, 2), 5)
---

<Layout title="Home" showSignup showBanner={true}>
  <section
    class="relative overflow-hidden bg-foreground text-background"
    style="min-height: clamp(480px, 70vh, 720px);"
  >
    {
      heroImageUrl && (
        <img
          src={heroImageUrl}
          alt={home?.heroHeadline || "Tidewater DSA"}
          class="absolute inset-0 h-full w-full object-cover object-[center_30%]"
        />
      )
    }
    <div
      class="absolute inset-0"
      style="background:
        radial-gradient(ellipse at 70% 20%, transparent 0%, rgba(10,10,10,0.5) 70%),
        linear-gradient(180deg, rgba(10,10,10,0.2) 0%, rgba(10,10,10,0.55) 60%, rgba(10,10,10,0.92) 100%);"
    >
    </div>

    <div
      class={cn(
        "relative z-10 mx-auto flex h-full max-w-7xl flex-col justify-end px-5 pt-8 pb-14 sm:px-6 sm:pt-24 md:pb-18",
        ctaPositionClasses[ctaPosition]
      )}
    >
      {
        heroParts && (
          <h1
            class="heading-display mb-5 max-w-[16ch] text-white"
            style="font-size: clamp(2.6rem, 7vw, 5.4rem); text-shadow: 0 2px 12px rgba(0,0,0,0.35);"
          >
            {heroParts.before}
            {heroParts.accent && (
              <em class="text-primary not-italic">{heroParts.accent}</em>
            )}
            {heroParts.after}
          </h1>
        )
      }

      {
        home?.heroSubheadline && (
          <p class="mb-7 max-w-[56ch] text-[clamp(1rem,1.3vw,1.2rem)] leading-relaxed text-white/95">
            {home.heroSubheadline}
          </p>
        )
      }

      {
        (home?.heroCtaText || home?.heroCta2Text) && (
          <div class="flex flex-wrap gap-3">
            {home?.heroCtaText && (
              <a
                href={home.heroCtaLink || "#"}
                class={cn(
                  "rounded-lg border-2 border-primary bg-primary px-6 py-3 text-base font-bold whitespace-nowrap text-primary-foreground transition-all sm:px-8 sm:py-4 sm:text-lg",
                  "hover:-translate-y-px hover:border-primary-deep hover:bg-primary-deep"
                )}
              >
                {home.heroCtaText}
              </a>
            )}
            {home?.heroCta2Text && (
              <a
                href={home.heroCta2Link || "#"}
                class={cn(
                  "rounded-lg border-2 border-white bg-transparent px-6 py-3 text-base font-bold whitespace-nowrap text-white transition-all sm:px-8 sm:py-4 sm:text-lg",
                  "hover:bg-white hover:text-foreground"
                )}
              >
                {home.heroCta2Text}
              </a>
            )}
          </div>
        )
      }
    </div>

    <div class="absolute right-0 bottom-0 left-0 z-20 h-1.5 bg-primary"></div>
  </section>

  {
    (home?.body || home?.contentHeadline) && (
      <section class="layout-container">
        <SectionHeading
          eyebrow={home?.contentEyebrow}
          headline={home?.contentHeadline}
        />

        <div class="grid grid-cols-1 items-start gap-9 md:grid-cols-[7fr_5fr] md:gap-14">
          <div>{home?.body && <RichText value={home.body} />}</div>

          <div
            class="relative mt-2 w-full transition-all duration-300"
            style={`aspect-ratio: 4 / ${aspectDenominator};`}
          >
            <div
              class="absolute z-0 bg-primary"
              style="inset: 14px -14px -14px 14px;"
            />
            {bodyImageUrl ? (
              <img
                src={bodyImageUrl}
                alt="About Tidewater DSA"
                class="relative z-10 h-full w-full object-cover"
              />
            ) : (
              <div class="relative z-10 flex h-full w-full flex-col items-center justify-center bg-primary/5 p-6 text-center text-primary/40">
                <span class="font-medium">About Image Space</span>
                <span class="mt-1 text-sm">Add a 'bodyImage' in Sanity</span>
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  <section class="bg-paper">
    <div class="layout-container">
      <SectionHeading
        eyebrow={home?.eventsEyebrow}
        headline={home?.eventsHeadline}
      />

      {
        events.length > 0 ? (
          <UpcomingEvents
            client:visible
            events={events}
            eventTypes={eventTypes}
            sideImageUrl={eventsImageUrl}
            noRsvpMessage={home?.noRsvpMessage}
          />
        ) : (
          <Card className="border-2 rounded-sm bg-background/60 shadow-none">
            <CardContent className="flex flex-col items-center gap-4 py-12 text-center">
              <div class="flex h-16 w-16 items-center justify-center rounded-full bg-primary-soft">
                <CalendarIcon className="h-8 w-8 text-primary" />
              </div>
              <div class="space-y-2">
                <p class="heading-display text-2xl">
                  {home?.noEventsHeadline || "We're planning our next move."}
                </p>
                <p class="mx-auto max-w-md text-foreground-soft">
                  {home?.noEventsBody ||
                    "No events are scheduled right now, but we're always organizing. Join our mailing list below to be the first to know when something's coming up."}
                </p>
              </div>
              <a
                href="#signup"
                class={cn(
                  "mt-2 inline-flex items-center gap-2 rounded-lg border-2 border-foreground bg-transparent px-5 py-2.5 font-bold text-foreground transition-all",
                  "hover:bg-foreground hover:text-background"
                )}
              >
                <CalendarIcon className="h-4 w-4" />
                Get notified about events
              </a>
            </CardContent>
          </Card>
        )
      }
    </div>
  </section>
</Layout>
