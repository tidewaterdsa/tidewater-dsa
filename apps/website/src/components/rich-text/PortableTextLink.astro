---
import type { SanityLinkMarkDef } from "@/types"

interface Props {
  node: {
    // Keep optional to handle gracefully in the event of a bad link being passed
    markDef?: SanityLinkMarkDef
  }
}

const { node } = Astro.props
const { href, blank } = node.markDef || {}
---

<a
  href={href}
  target={blank ? "_blank" : undefined}
  rel={blank ? "noopener noreferrer" : undefined}><slot /></a
>
