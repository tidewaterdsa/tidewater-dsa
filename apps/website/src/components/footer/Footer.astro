---
import { detectSocialPlatform, getSocialIcon } from "@/lib/social"
import { cn } from "@tidewater-dsa/ui/lib/utils"
import EmailLink from "./EmailLink.astro"
import type { IconVariant, Settings } from "@/types"
import { isExternalHref } from "@/lib/url"

interface Props {
  socialLinks: Settings["socialLinks"]
  iconVariant: IconVariant
  contactEmail?: string | null
  contactEmailSubject?: string | null
  logoUrl: string | null
  siteName: string
  footerTagline: Settings["footerTagline"]
  footerColumns: Settings["footerColumns"]
  footerNoteLeft: Settings["footerNoteLeft"]
  footerNoteRight: Settings["footerNoteLeft"]
}

const {
  socialLinks,
  iconVariant,
  contactEmail,
  contactEmailSubject,
  logoUrl,
  siteName,
  footerTagline,
  footerColumns,
  footerNoteLeft,
  footerNoteRight,
} = Astro.props

const validSocialLinks =
  socialLinks?.filter(
    (social): social is { platform: string; url: string; _key: string } =>
      Boolean(social.platform && social.url)
  ) ?? []

// Cap dynamic columns at 4 to prevent layout breakage
const columnCount = Math.min(footerColumns?.length || 0, 4)

const gridLayouts: Record<number, string> = {
  0: "md:grid-cols-[2fr_1fr]",
  1: "md:grid-cols-[2fr_1fr_1fr]",
  2: "md:grid-cols-[2fr_1fr_1fr_1fr]",
  3: "md:grid-cols-[2fr_1fr_1fr_1fr_1fr]",
  4: "md:grid-cols-[2fr_1fr_1fr_1fr_1fr_1fr]",
}

const gridColsClass = gridLayouts[columnCount] || gridLayouts[2]
---

<footer class="bg-foreground pt-14 pb-7 text-background">
  <div class="mx-auto max-w-7xl px-5 sm:px-6">
    <div class={cn("grid gap-12", gridColsClass)}>
      {/* Brand column */}
      <div>
        <div class="mb-4 flex items-center gap-3">
          {
            logoUrl && (
              <img
                src={logoUrl}
                alt={siteName}
                class="h-12 w-auto shrink-0 rounded-sm object-contain"
              />
            )
          }
          <span
            class="font-heading text-xl leading-none font-extrabold tracking-tight uppercase"
          >
            {siteName}
          </span>
        </div>
        {
          footerTagline && (
            <p class="max-w-[36ch] text-sm leading-relaxed text-background/70">
              {footerTagline}
            </p>
          )
        }
      </div>

      {/* Dynamic Columns */}
      {
        footerColumns?.map((column) => {
          const validLinks =
            column.links?.filter(
              (link): link is { label: string; href: string; _key: string } =>
                Boolean(link.label && link.href)
            ) ?? []

          return (
            <div>
              {validLinks.length > 0 && (
                <>
                  <h4 class="mono-eyebrow mb-3 text-primary">{column.title}</h4>
                  <ul class="flex list-none flex-col gap-2.5 p-0">
                    {validLinks.map((link) => (
                      <li>
                        <a
                          href={link.href}
                          target={
                            isExternalHref(link.href) ? "_blank" : undefined
                          }
                          rel={
                            isExternalHref(link.href) ? "noreferrer" : undefined
                          }
                          class="text-sm text-background/85 no-underline hover:text-primary"
                        >
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              )}
            </div>
          )
        })
      }

      {/* Follow / socials column */}
      <div>
        {
          validSocialLinks.length > 0 && (
            <div>
              <h4 class="mono-eyebrow mb-3 text-primary">Follow</h4>
              <div class="flex gap-2">
                {validSocialLinks.map((social) => {
                  const {
                    icon: IconComponent,
                    color,
                    filledColor,
                    bg,
                  } = getSocialIcon(detectSocialPlatform(social.platform))
                  const isFilled = iconVariant === "filled"
                  return (
                    <a
                      href={social.url}
                      target="_blank"
                      rel="noreferrer"
                      aria-label={social.platform}
                      class={cn(
                        "flex h-9 w-9 items-center justify-center rounded-md border border-white/20 transition-all hover:border-white/40",
                        isFilled
                          ? bg +
                              " border-transparent text-white hover:scale-110 hover:brightness-110"
                          : "text-white/70 hover:bg-white/10"
                      )}
                    >
                      <IconComponent
                        className={cn(
                          isFilled ? (filledColor ?? "text-white") : color
                        )}
                      />
                    </a>
                  )
                })}
              </div>
              {contactEmail && (
                <div class="mt-4 text-sm text-background/70">
                  <EmailLink
                    email={contactEmail}
                    subject={contactEmailSubject}
                  />
                </div>
              )}
            </div>
          )
        }
      </div>
    </div>

    {
      (footerNoteLeft || footerNoteRight) && (
        <div class="mono-eyebrow-sm mt-12 flex flex-wrap justify-between gap-4 border-t border-white/10 pt-6 uppercase opacity-60">
          <span>{footerNoteLeft}</span>
          <span>{footerNoteRight}</span>
        </div>
      )
    }
  </div>
</footer>
