---
import { MobileNav } from "./MobileNav"
import { buttonVariants } from "@tidewater-dsa/ui/components/button"
import { HeartIcon } from "lucide-react"
import type { Settings, ValidNavLink } from "@/types"
import { cn } from "@tidewater-dsa/ui/lib/utils"

interface Props {
  logoUrl: string | null
  title: string
  siteName: string
  logoTagline: Settings["logoTagline"]
  navLinks: ValidNavLink[]
  callToActionText: Settings["callToActionText"]
  callToActionLink: Settings["callToActionLink"]
  currentPath: string
}

const {
  logoUrl,
  title,
  siteName,
  logoTagline,
  navLinks,
  callToActionText,
  callToActionLink,
  currentPath,
} = Astro.props

const normalizePath = (path: string): string => path.replace(/^\/+|\/+$/g, "")

const currentSlug = normalizePath(currentPath)

const isCurrentLink = (slug: string): boolean =>
  normalizePath(slug) === currentSlug
---

<header
  class="sticky top-0 z-50 border-b border-border bg-background/95 backdrop-blur"
>
  <div
    class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3.5 sm:gap-5 sm:px-6"
  >
    <a
      href="/"
      class="flex shrink-0 items-center gap-3 text-foreground transition-opacity hover:opacity-90"
    >
      {
        logoUrl && (
          <img
            src={logoUrl}
            alt={title || "Site Logo"}
            class="h-12 w-auto shrink-0 rounded-sm object-contain"
          />
        )
      }
      <div class="leading-none">
        <div
          class="-ml-0.75 font-heading text-2xl leading-none font-extrabold tracking-tight uppercase"
        >
          {siteName}
        </div>
        {
          logoTagline && (
            <div class="mono-eyebrow mt-1 text-xs tracking-widest text-foreground-soft">
              {logoTagline}
            </div>
          )
        }
      </div>
    </a>

    <nav class="hidden shrink-0 items-center gap-7 lg:flex">
      {
        navLinks.map((link) => {
          const current = isCurrentLink(link.slug)
          return (
            <a
              href={`/${link.slug}`}
              aria-current={current ? "page" : undefined}
              class="group relative py-1 font-semibold whitespace-nowrap text-foreground"
            >
              {link.title}
              <span
                class:list={[
                  "absolute bottom-0 left-0 h-0.5 bg-primary transition-[width] duration-200",
                  current ? "w-full" : "w-0 group-hover:w-full",
                ]}
              />
            </a>
          )
        })
      }

      {
        callToActionLink && callToActionText && (
          <a
            href={callToActionLink}
            target="_blank"
            rel="noreferrer"
            class={cn(
              buttonVariants({ size: "default" }),
              "ml-2 cursor-pointer gap-1.5 rounded-md px-3.5 text-base font-bold text-foreground hover:bg-primary-deep"
            )}
          >
            <HeartIcon fill="currentColor" />
            {callToActionText}
          </a>
        )
      }
    </nav>

    <div class="flex items-center lg:hidden">
      <MobileNav
        client:load
        navLinks={navLinks}
        callToActionText={callToActionText ?? null}
        callToActionLink={callToActionLink ?? null}
        pathname={currentPath}
      />
    </div>
  </div>
</header>
