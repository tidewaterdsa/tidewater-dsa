---
import "@/styles/app.css"
import "@/styles/action-network.css"

import { VisualEditing } from "@sanity/astro/visual-editing"
import { loadQuery } from "@/lib/load-query"
import { SITE_SETTINGS_QUERY } from "@/sanity/queries"
import type { SITE_SETTINGS_QUERY_RESULT } from "@/sanity/types"
import Footer from "@/components/footer/Footer.astro"
import Header from "@/components/header/Header.astro"
import { urlFor } from "@/lib/sanity-image"
import { extractActionNetworkInfo } from "@/lib/action-network"
import { getNextMeeting } from "@/lib/next-meeting"
import type { IconVariant, ValidNavLink } from "@/types"
import { stegaClean } from "@sanity/client/stega"

interface Props {
  title?: string
  /** Render the red-banner Action Network signup section above the footer. */
  showSignup?: boolean
  /** Render the chapter-motto strip. */
  showBanner?: boolean
}

const { title, showSignup = false, showBanner = false } = Astro.props

const { data: settings } = await loadQuery<SITE_SETTINGS_QUERY_RESULT>({
  query: SITE_SETTINGS_QUERY,
})

const siteFullName = settings?.siteTitle || "Tidewater DSA"
const siteShortName = settings?.siteShortName || siteFullName

const formattedTitle = title ? `${title} | ${siteFullName}` : siteFullName

const logoUrl = settings?.logo?.asset
  ? urlFor(settings.logo).height(400).url()
  : null

const visualEditingEnabled =
  import.meta.env.PUBLIC_SANITY_VISUAL_EDITING_ENABLED === "true"

const iconVariant: IconVariant =
  stegaClean(settings?.socialIconStyle) === "filled" ? "filled" : "outline"

const signupInfo = settings?.signupLink
  ? extractActionNetworkInfo(settings.signupLink)
  : null

const signupEmbed =
  signupInfo && signupInfo.type === "form"
    ? {
        scriptUrl: `https://actionnetwork.org/widgets/v2/${signupInfo.type}/${signupInfo.slug}?format=js&source=widget`,
        containerId: `can-${signupInfo.type}-area-${signupInfo.slug}`,
      }
    : null

const validNavLinks: ValidNavLink[] =
  settings?.navLinks?.filter((link): link is ValidNavLink =>
    Boolean(link.title && link.slug)
  ) ?? []

const ribbonVisible = settings?.showRibbon !== false

const ribbonOverrideText = settings?.nextMeetingTextOverride?.trim() || null

const shouldFetchNextMeeting =
  ribbonVisible &&
  !ribbonOverrideText &&
  Boolean(settings?.nextMeetingMatch?.trim())

const nextMeeting =
  shouldFetchNextMeeting && settings?.nextMeetingMatch
    ? await getNextMeeting(
        {
          match: settings.nextMeetingMatch,
          label: settings.nextMeetingLabel?.trim() || "Next general meeting",
        },
        Astro.locals.runtime?.env
      )
    : null

// Resolve the final right-side text and link from the four possible sources.
const ribbonRightText = ribbonOverrideText || nextMeeting?.text || null
const ribbonRightLink =
  settings?.nextMeetingLinkOverride ||
  nextMeeting?.href ||
  (ribbonOverrideText ? "/events" : null)

const bannerWords =
  showBanner && settings?.bannerWords && settings.bannerWords.length > 0
    ? settings.bannerWords
    : null

const signupHeadline = settings?.signupHeadline ?? null

const currentPath = Astro.url.pathname
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{formattedTitle}</title>
  </head>
  <body class="flex min-h-screen flex-col bg-background text-foreground">
    {
      ribbonVisible && (settings?.ribbonText || ribbonRightText) && (
        <div class="bg-foreground text-background">
          <div class="mono-eyebrow mx-auto flex max-w-7xl flex-wrap justify-center gap-3 px-5 py-1.5 max-sm:text-[0.625rem] sm:px-6 md:justify-between">
            {settings?.ribbonText ? (
              <span class="inline-flex items-center">
                <span class="mr-2 inline-block h-1.5 w-1.5 -translate-y-px rounded-full bg-primary" />
                {settings.ribbonText}
              </span>
            ) : (
              <span aria-hidden="true" />
            )}
            {ribbonRightText &&
              (ribbonRightLink ? (
                <a
                  href={ribbonRightLink}
                  class="opacity-85 transition-opacity hover:opacity-100"
                >
                  {ribbonRightText}
                </a>
              ) : (
                <span class="opacity-85">{ribbonRightText}</span>
              ))}
          </div>
        </div>
      )
    }

    <Header
      logoUrl={logoUrl}
      title={siteFullName}
      siteName={siteShortName}
      logoTagline={settings?.logoTagline ?? null}
      navLinks={validNavLinks}
      callToActionText={settings?.callToActionText ?? null}
      callToActionLink={settings?.callToActionLink ?? null}
      currentPath={currentPath}
    />

    <main class="grow">
      <slot />

      {
        bannerWords && (
          <div class="bg-foreground py-5 text-background">
            <div class="flex min-w-0 flex-nowrap items-center justify-center gap-x-4 px-4 font-heading text-[clamp(1rem,2.4vw,2.4rem)] leading-none font-extrabold tracking-wide whitespace-nowrap uppercase lg:gap-x-6">
              {bannerWords.map((word, i) => (
                <>
                  <span>{word}</span>
                  {i < bannerWords.length - 1 && (
                    <span
                      class="-translate-y-px text-primary"
                      aria-hidden="true"
                    >
                      ✦
                    </span>
                  )}
                </>
              ))}

              <span class="contents max-md:hidden">
                <span class="-translate-y-px text-primary" aria-hidden="true">
                  ✦
                </span>
                {bannerWords.map((word, i) => (
                  <>
                    <span>{word}</span>
                    {i < bannerWords.length - 1 && (
                      <span
                        class="-translate-y-px text-primary"
                        aria-hidden="true"
                      >
                        ✦
                      </span>
                    )}
                  </>
                ))}
              </span>
            </div>
          </div>
        )
      }

      {
        showSignup && (
          <section
            id="signup"
            class="relative overflow-hidden bg-primary py-16 text-primary-foreground md:py-20"
          >
            <div class="grain-overlay pointer-events-none absolute inset-0 opacity-50 mix-blend-multiply" />
            <div class="relative mx-auto grid max-w-7xl items-start gap-10 px-5 sm:px-6 md:grid-cols-[5fr_7fr] md:gap-14">
              <div>
                <div class="mb-4 border-t-2 border-white pt-6">
                  {settings?.signupEyebrow && (
                    <span class="mono-eyebrow mb-3 block text-white opacity-85">
                      {settings.signupEyebrow}
                    </span>
                  )}
                  {signupHeadline && (
                    <h2
                      class="heading-display text-white"
                      style="font-size: clamp(2.25rem, 5vw, 3.6rem);"
                    >
                      {signupHeadline}
                    </h2>
                  )}
                </div>
                {settings?.signupDescription && (
                  <p class="mt-4 max-w-[44ch] leading-relaxed text-white/95">
                    {settings.signupDescription}
                  </p>
                )}
              </div>

              <div class="rounded-lg bg-background p-7 text-foreground shadow-[0_24px_60px_-20px_rgba(0,0,0,0.4)] sm:p-8">
                <div class="an-embed an-signup">
                  {signupEmbed ? (
                    <>
                      <div id={signupEmbed.containerId} style="width: 100%" />
                      <link
                        rel="stylesheet"
                        href="https://actionnetwork.org/css/style-embed-whitelabel-v3.css"
                        data-an-styles
                      />
                      <script is:inline src={signupEmbed.scriptUrl} />
                    </>
                  ) : (
                    <p class="text-sm text-muted-foreground italic">
                      Signup form coming soon.
                    </p>
                  )}
                </div>
              </div>
            </div>
          </section>
        )
      }
    </main>

    <Footer
      socialLinks={settings?.socialLinks ?? []}
      iconVariant={iconVariant}
      contactEmail={settings?.contactEmail}
      contactEmailSubject={settings?.contactEmailSubject}
      logoUrl={logoUrl}
      siteName={siteShortName}
      footerTagline={settings?.footerTagline ?? null}
      footerColumns={settings?.footerColumns ?? []}
      footerNoteLeft={settings?.footerNoteLeft ?? null}
      footerNoteRight={settings?.footerNoteRight ?? null}
    />
    <VisualEditing enabled={visualEditingEnabled} zIndex={1000} />
  </body>
</html>
