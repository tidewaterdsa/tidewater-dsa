{
  "name": "tidewater-dsa",
  "main": "./dist/_worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    // Astro adapter calls env.ASSETS.fetch() for any route it cannot match. 
    // Without a binding name that throws, turning 404s into 500s.
    "binding": "ASSETS",
  },
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_SANITY_VISUAL_EDITING_ENABLED": "false",
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "289467be6406419093376626bd86bb78",
      "preview_id": "47e565590c6b46e48b5cb9965d1a27b2",
    },
  ],
  "env": {
    "staging": {
      "name": "tidewater-dsa-staging",
      "main": "./dist/_worker.js",
      "compatibility_date": "2025-04-01",
      "compatibility_flags": ["nodejs_compat"],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
      },
      "kv_namespaces": [
        {
          "binding": "CACHE",
          "id": "999d257f38114f3bb9cb418734e9f042",
          "preview_id": "fac3c337e8684b75b86c9866e830e836",
        },
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "PUBLIC_SANITY_VISUAL_EDITING_ENABLED": "true",
      },
    },
  },
}
