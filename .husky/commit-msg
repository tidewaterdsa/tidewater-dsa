commit_msg_file="$1"
commit_msg=$(head -n1 "$commit_msg_file")

# Allow merge, revert, and fixup commits to pass through unchanged.
if printf '%s' "$commit_msg" | grep -Eq '^(Merge |Revert |fixup!|squash!)'; then
  exit 0
fi

# Conventional-commit prefixes the monorepo enforces.
# Format: <type>(optional scope): <subject>
#   type  ::= feat | fix | chore | docs | refactor | style | test | perf | build | ci
#   scope ::= any non-empty string in parentheses (optional)
pattern='^(feat|fix|chore|docs|refactor|style|test|perf|build|ci)(\([^)]+\))?!?: .+'

if ! printf '%s' "$commit_msg" | grep -Eq "$pattern"; then
  RED='\033[0;31m'
  YELLOW='\033[0;33m'
  NC='\033[0m'

  printf '\n'
  printf '%bERROR: Commit message does not follow the required convention.%b\n' "$RED" "$NC"
  printf '\n'
  printf 'Your message:\n'
  printf '  %b%s%b\n' "$YELLOW" "$commit_msg" "$NC"
  printf '\n'
  printf 'Expected format:\n'
  printf '  <type>(optional scope): <subject>\n'
  printf '\n'
  printf 'Allowed types: feat, fix, chore, docs, refactor, style, test, perf, build, ci\n'
  printf '\n'
  printf 'Examples:\n'
  printf '  feat: add events calendar filter\n'
  printf '  fix(website): correct timezone on event card\n'
  printf '  chore: bump turbo to 2.8.17\n'
  printf '\n'
  exit 1
fi
