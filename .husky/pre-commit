echo "Running Sanity type generator..."
CI=true npm run typegen

GENERATED="apps/website/sanity/types.ts apps/website/sanity/generated/routes.ts"

if ! git --no-pager diff --exit-code $GENERATED > /dev/null; then
  RED='\033[0;31m'
  NC='\033[0m'

  echo -e ""
  echo -e "${RED}ERROR: Generated files are out of sync with your schemas and routes.${NC}"
  echo -e "${RED}The generators just updated:${NC}"
  git --no-pager diff --name-only $GENERATED | sed 's/^/  /'
  echo -e "${RED}Stage them (git add <file>) and commit again.${NC}"
  echo -e ""
  exit 1
fi

echo "Running monorepo linter..."
CI=true npm run lint